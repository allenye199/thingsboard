<!--=======================================================================-->
<!--=====  猪场添加模板   =====-->
<!--=======================================================================-->

<form #addEntityForm="ngForm" [formGroup]="addEntityFormGroup"
      (ngSubmit)="save()" class="add-entity-form">
  <mat-toolbar class="flex flex-row" color="primary">
    <h2>添加猪场</h2>
    <span class="flex-1"></span>
    <button mat-icon-button (click)="cancel()" type="button">
      <mat-icon class="material-icons">close</mat-icon>
    </button>
  </mat-toolbar>
  <mat-progress-bar color="warn" mode="indeterminate" *ngIf="isLoading$ | async">
  </mat-progress-bar>
  <div style="height: 4px;" *ngIf="!(isLoading$ | async)"></div>
  <div mat-dialog-content class="flex flex-col">
    <mat-form-field class="mat-block">
      <mat-label>猪场名称</mat-label>
      <input matInput formControlName="title" required>
    </mat-form-field>
    
    <div class="flex flex-row gap-2 xs:flex-col xs:gap-0">
      <mat-form-field class="mat-block flex-1">
        <mat-label>负责人</mat-label>
        <input matInput formControlName="leader">
      </mat-form-field>
      <div class="boolean-value-input flex flex-row items-center justify-end">
        <mat-label class="enabled-label">启用</mat-label>
        <mat-checkbox formControlName="farm_enable"></mat-checkbox>
      </div>
    </div>
    
    <div class="flex flex-row gap-2 xs:flex-col xs:gap-0">
      <mat-form-field class="mat-block flex-1">
        <mat-label>国家</mat-label>
        <input matInput formControlName="country">
      </mat-form-field>
      <mat-form-field class="mat-block flex-1">
        <mat-label>省份</mat-label>
        <input matInput formControlName="state">
      </mat-form-field>
    </div>
    <div class="flex flex-row gap-2 xs:flex-col xs:gap-0">
      <mat-form-field class="mat-block flex-1">
        <mat-label>城市</mat-label>
        <input matInput formControlName="city">
      </mat-form-field>
      <mat-form-field class="mat-block flex-1">
        <mat-label>邮编</mat-label>
        <input matInput formControlName="zip">
      </mat-form-field>
    </div>
    <mat-form-field class="mat-block">
      <mat-label>地址</mat-label>
      <input matInput formControlName="address">
    </mat-form-field>
    <div formGroupName="additionalInfo" class="flex flex-col">
      <mat-form-field class="mat-block">
        <mat-label>描述</mat-label>
        <textarea matInput formControlName="description" rows="2"></textarea>
      </mat-form-field>
      <div class="flex flex-row gap-2 xs:flex-col xs:gap-0">
        <mat-form-field class="mat-block flex-1">
          <mat-label>国家代码</mat-label>
          <mat-select formControlName="countrycode">
            <mat-option *ngFor="let code of countryCodes" [value]="code.value">
              {{code.label}}
            </mat-option>
          </mat-select>
        </mat-form-field>
        <mat-form-field class="mat-block flex-1">
          <mat-label>电话号码</mat-label>
          <input matInput formControlName="phone">
          <mat-hint>格式: 1xx-xxxx-xxxx</mat-hint>
        </mat-form-field>
      </div>
    </div>
    <mat-form-field class="mat-block">
      <mat-label>电子邮件</mat-label>
      <input type="email" matInput formControlName="email">
      <mat-error *ngIf="addEntityFormGroup.get('email').hasError('email') && !addEntityFormGroup.get('email').hasError('required')">
        请输入有效的电子邮件地址
      </mat-error>
    </mat-form-field>
  </div>
  <div mat-dialog-actions class="flex flex-row items-center justify-end">
    <button mat-button color="primary"
            type="button"
            [disabled]="(isLoading$ | async)"
            (click)="cancel()" cdkFocusInitial>
      取消
    </button>
    <button mat-button mat-raised-button color="primary"
            type="submit"
            [disabled]="(isLoading$ | async) || addEntityForm.invalid">
      创建
    </button>
  </div>
</form>
